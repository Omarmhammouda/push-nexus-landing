{
  // Push Analytics Cloudflare account. Workers Builds runs `npm run build`, then `npx wrangler deploy`.
  "name": "push-nexus",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Request-access form: emails each submission (POST /api/access). Both recipients must be
  // verified Email Routing addresses, and pushnexus.ai must be onboarded under Email Sending.
  "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["hamdy@pushanalytics.com", "moustafa@pushanalytics.com"] }],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
  // Add the live domain here once it is on the Push Analytics account, e.g.
  // "routes": [{ "pattern": "pushnexus.ai", "custom_domain": true }]
}
